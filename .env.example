# Copy to .env (git ignores it) or run: python3 src/setup_env.py
# Load before running scripts:  set -a; source .env; set +a
WILEY_TDM_TOKEN=<TOKEN>          # Wiley text-and-data-mining token (downloads of Wiley papers)
ELSEVIER_API_KEY=<API_KEY>       # dev.elsevier.com, created with the TDM provisions accepted
ELSEVIER_INSTTOKEN=              # optional; without it Elsevier full text works only on the university network
OPENALEX_API_KEY=<API_KEY>       # only for building new tasks
GEMINI_API_KEY=<API_KEY>         # judge, question rewrites, running ScheMatiQ
GEMINI_MODEL=gemini-3.8-flash    # optional
